@PACKAGE_INIT@

# ---------------------------------------------------------------------------
# Locate nanocbor
# ---------------------------------------------------------------------------
# nanocbor has no upstream CMake package config, so we replicate the same
# override-then-search flow used by ccoreconf's own build.
#
# Override variables (in priority order):
#   1. NANOCBOR_INCLUDE / NANOCBOR_BUILD  -D... or env
#   2. Standard system search paths

if(DEFINED ENV{NANOCBOR_INCLUDE} AND NOT NANOCBOR_INCLUDE)
    set(NANOCBOR_INCLUDE $ENV{NANOCBOR_INCLUDE})
endif()
if(DEFINED ENV{NANOCBOR_BUILD} AND NOT NANOCBOR_BUILD)
    set(NANOCBOR_BUILD $ENV{NANOCBOR_BUILD})
endif()

find_path(_ccoreconf_nanocbor_include_dir
    NAMES nanocbor/nanocbor.h
    HINTS "${NANOCBOR_INCLUDE}"
)
find_library(_ccoreconf_nanocbor_library
    NAMES nanocbor
    HINTS "${NANOCBOR_BUILD}"
)

if(NOT _ccoreconf_nanocbor_include_dir OR NOT _ccoreconf_nanocbor_library)
    if(NANOCBOR_INCLUDE OR NANOCBOR_BUILD)
        set(_ccoreconf_hint " Tried NANOCBOR_INCLUDE='${NANOCBOR_INCLUDE}', "
                            "NANOCBOR_BUILD='${NANOCBOR_BUILD}'.")
    endif()
    message(FATAL_ERROR
        "ccoreconf requires nanocbor, but it could not be located.${_ccoreconf_hint}\n"
        "Install nanocbor or set NANOCBOR_INCLUDE / NANOCBOR_BUILD "
        "(either as -D variables or as environment variables). "
        "See CMAKE_BUILD.md for details.")
endif()

if(NOT TARGET nanocbor::nanocbor)
    add_library(nanocbor::nanocbor UNKNOWN IMPORTED)
    set_target_properties(nanocbor::nanocbor PROPERTIES
        IMPORTED_LOCATION             "${_ccoreconf_nanocbor_library}"
        INTERFACE_INCLUDE_DIRECTORIES "${_ccoreconf_nanocbor_include_dir}"
    )
endif()

# ---------------------------------------------------------------------------
# ccoreconf imported targets
# ---------------------------------------------------------------------------
include("${CMAKE_CURRENT_LIST_DIR}/ccoreconfTargets.cmake")

check_required_components(ccoreconf)
